# Copy this file to ".env" and fill in the values. Never share or commit .env.

# Signs login tokens. Any long random string (changing it logs everyone out).
SECRET_KEY=change-me-to-a-long-random-string
# Students must enter this to create an account. Leave blank to allow anyone.
CLASS_CODE=BVDU2026

# --- Google Gemini (free) ---
GEMINI_MODEL=gemini-2.5-flash
# Optional: your own key, used for people who haven't added theirs (only if ALLOW_SHARED_KEY=true).
# Free limits are per Google project, so a shared key is split among everyone using it.
GEMINI_API_KEY=
ALLOW_SHARED_KEY=false

# --- Supabase (Project settings -> API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...        # service_role key - keep secret, server only
SUPABASE_BUCKET=wa-media

# --- Optional ---
YOUTUBE_API_KEY=
FETCH_TRANSCRIPTS=true
TIMEZONE=Asia/Kolkata
MAX_UPLOAD_MB=20
